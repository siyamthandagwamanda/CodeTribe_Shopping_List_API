{
  "info": {
    "name": "Shopping List API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/items",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items"]
        }
      }
    },
    {
      "name": "Create Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data?.id) {",
              "    pm.collectionVariables.set('latest_item_id', res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Apples\",\n    \"quantity\": 6\n}"
        },
        "url": {
          "raw": "http://localhost:3000/items",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items"]
        }
      }
    },
    {
      "name": "Get Item by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/items/{{latest_item_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items", "{{latest_item_id}}"]
        }
      }
    },
    {
      "name": "Update Item",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Organic Apples\",\n    \"quantity\": \"1 Bag\",\n    \"purchased\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3000/items/{{latest_item_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items", "{{latest_item_id}}"]
        }
      }
    },
    {
      "name": "Delete Item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/items/{{latest_item_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items", "{{latest_item_id}}"]
        }
      }
    },
    {
      "name": "Create Item - Invalid Input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"\",\n    \"quantity\": false\n}"
        },
        "url": {
          "raw": "http://localhost:3000/items",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["items"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "latest_item_id",
      "value": "1",
      "type": "string"
    }
  ]
}
